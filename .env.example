# Copy this file to .env and adjust values for your local environment.
# .env is git-ignored — never commit real credentials.

# SQLAlchemy-style connection string for PostgreSQL.
DATABASE_URL=postgresql+psycopg://forex:forex@localhost:5432/forex_intelligence

# One of: development, test, staging, production
APP_ENV=development

# Standard Python logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
